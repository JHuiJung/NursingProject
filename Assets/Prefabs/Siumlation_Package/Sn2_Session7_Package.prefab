  simulation_Quiz_Index: 30
  Obj_CanvasChoice: {fileID: 937733531323486794}
  text_Question: "Q30. Dopamine 40mg/mL \uC81C\uC81C\uB97C 1mg/mL\uB85C \uD76C\uC11D\uD558\uAE30
    \uC704\uD55C \uC62C\uBC14\uB978 \uBC29\uBC95\uC740 \uBB34\uC5C7\uC785\uB2C8\uAE4C?"
  Tmp_Question: {fileID: 2117966499473170134}
  text_Answer: "\uC6D0\uC561 1mL(=40mg)\uB97C + N/S 39mL\uC640 \uD63C\uD569 -> \uCD1D
