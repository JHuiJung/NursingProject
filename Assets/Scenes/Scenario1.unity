  - sprite: {fileID: 21300000, guid: 8ea3d979d3cbcac4db6b0ee8bb53bb9d, type: 3}
    text_Answer: "\uC801\uD569, \uC6A9\uAE30\uAC00 \uAC1C\uBD09\uB418\uC9C0 \uC54A\uACE0
