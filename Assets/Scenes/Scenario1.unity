  - sprite: {fileID: 21300000, guid: 0f31fbbd01396b046b62a835bc410941, type: 3}
    text_Answer: "\uBD80\uC801\uD569, \uBC14\uC774\uC54C\uC5D0 \uADE0\uC5F4(crack)\uC774\uB098
