  m_Script: {fileID: 11500000, guid: 9a773a4f28962294d84d21a1a2fc2aab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Obj_CanvasChoice: {fileID: 925923170}
  text_Question: "Q5. \uC774 \uC57D\uBB3C\uC758 \uC131\uBD84\uC740 \uBB34\uC5C7\uC778\uAC00\uC694?"
  Tmp_Question: {fileID: 2036298827}
  text_Answer: "\uC138\uD314\uB85C\uC2A4\uD3EC\uB9B0\uACC4 \uD56D\uC0DD\uBB3C\uC9C8
    (Cephalosporin)"
  text_Dummies:
  - "\uC554\uD53C\uC2E4\uB9B0\uACC4 \uD56D\uC0DD\uBB3C\uC9C8 (Ampicillin)"
  - "\uC544\uBAA9\uC2DC\uC2E4\uB9B0\uACC4 \uD56D\uC0DD\uBB3C\uC9C8 (Amoxicillin)"
  - "\uBA54\uB85C\uD398\uB134\uACC4 \uD56D\uC0DD\uBB3C\uC9C8 (Meropenem)"
  - "\uC820\uD0C0\uB9C8\uC774\uC2E0\uACC4 \uD56D\uC0DD\uBB3C\uC9C8 (Gentamicin)"
  - "\uBC18\uCF54\uB9C8\uC774\uC2E0\uACC4 \uD56D\uC0DD\uBB3C\uC9C8 (Vancomycin)"
  - "\uD14C\uD2B8\uB77C\uC0AC\uC774\uD074\uB9B0\uACC4 \uD56D\uC0DD\uBB3C\uC9C8 (Tetracycline)"
  - "\uD034\uB180\uB860\uACC4 \uD56D\uC0DD\uBB3C\uC9C8 (Ciprofloxacin)"
  - "\uB9C8\uD06C\uB85C\uB77C\uC774\uB4DC\uACC4 \uD56D\uC0DD\uBB3C\uC9C8 (Azithromycin)"
  - "\uC124\uD30C\uC81C\uACC4 \uD56D\uC0DD\uBB3C\uC9C8  (Sulfamethoxazole)"
  BTN_Choices:
  - {fileID: 132230233}
  - {fileID: 1608444797}
  - {fileID: 328100720}
  - {fileID: 1717664730}
  - {fileID: 24433053}
