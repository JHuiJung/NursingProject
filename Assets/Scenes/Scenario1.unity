  spriteAndTextAnswer_Dummies:
  - sprite: {fileID: 21300000, guid: 8ea3d979d3cbcac4db6b0ee8bb53bb9d, type: 3}
    isNormal: 0
    text_Content: "\uC801\uD569, \uC6A9\uAE30\uAC00 \uAC1C\uBD09\uB418\uC9C0 \uC54A\uACE0
      \uBC00\uBD09\uC774 \uB418\uC5B4\uC788\uC73C\uBA70 \uC774\uC0C1 \uC5EC\uBD80
      \uC5C6\uC2B5\uB2C8\uB2E4."
    text_Answer: "\uC801\uD569, \uC6A9\uAE30\uAC00 \uAC1C\uBD09\uB418\uC9C0 \uC54A\uACE0
      \uBC00\uBD09\uC774 \uB418\uC5B4\uC788\uC73C\uBA70 \uC774\uC0C1 \uC5EC\uBD80
      \uC5C6\uC2B5\uB2C8\uB2E4. \uB610\uD55C \uC720\uD1B5\uAE30\uD55C\uC5D0\uB3C4
      \uC774\uC0C1\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  - sprite: {fileID: 21300000, guid: 0f31fbbd01396b046b62a835bc410941, type: 3}
    isNormal: 0
    text_Content: "\uBD80\uC801\uD569, \uBC14\uC774\uC54C\uC5D0 \uADE0\uC5F4(crack)\uC774\uB098
      \uD30C\uC190\uC774 \uC788\uC2B5\uB2C8\uB2E4"
    text_Answer: "\uBD80\uC801\uD569, \uBC14\uC774\uC54C\uC5D0 \uADE0\uC5F4(crack)\uC774\uB098
      \uD30C\uC190\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uB610\uD55C \uC720\uD1B5\uAE30\uD55C\uC740
      \uC774\uC0C1\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
  - sprite: {fileID: 21300000, guid: 4b2f8318bba9ef6448170ac2bfe19719, type: 3}
    isNormal: 0
    text_Content: "\uBD80\uC801\uD569, \uC6A9\uAE30 \uD45C\uBA74\uC774\uB098 \uB77C\uBCA8\uC774
      \uC624\uC5FC\uC774 \uC788\uC2B5\uB2C8\uB2E4."
