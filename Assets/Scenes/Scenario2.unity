  m_text: "                                               ---anticonvulsant---\r\n\n\u25CF
    150mg Celebyx Inj(Forphenytoin Sodium)        1amp   \r\n\u25CF N/S 20ml (Pastic)(Sodium
    Chloride)              1amp \r\n\u25CF [loading]    150mg Celebyx Inj 20mg/kg/dose
    + N/S 10cc, over 30min 9am\r\n\u25CF [maintain]   150mg Celebyx Inj  4mg/kg/dose
    + N/S 10cc, over 10min q 12hrs\r\n\r\n                                             
    ---oral medication---\r\n\n-Tegretol syr. 1mL(20mg)                 2.5ml [P.O]
    tid pc\r\n-Keppra oral soln 100mg/1ml               1ml [P.O] tid pc\r\n-Phenobarbital
    Tab 30mg(Phenobarbital)  0.5tab [P.O] tid pc"
